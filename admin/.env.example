# Postgres (Supabase transaction pooler, port 6543). Tables live in schema "datuk_cms".
DATABASE_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
WEBSITE_URL=http://localhost:3000
# Same value as NUXT_FORM_SECRET on the website
FORM_SECRET=
# Key for the Excel downloads (/api/exports/...)
EXPORT_KEY=
# Vercel Cron sends this automatically
CRON_SECRET=
# Vercel Blob (photos). Leave empty locally to store files on disk.
BLOB_READ_WRITE_TOKEN=
# Optional email alerts
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@datukdrinder.com
NOTIFY_EMAIL=
# Only while importing old content; remove afterwards
SETUP_SECRET=
