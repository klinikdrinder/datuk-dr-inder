{
  "kind": "collectionType",
  "collectionName": "seminars",
  "info": {
    "singularName": "seminar",
    "pluralName": "seminars",
    "displayName": "Seminar",
    "description": "Seminars and talks. Upcoming ones show on the homepage automatically; past ones move to the archive."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "starts_at": {
      "type": "datetime",
      "required": true
    },
    "ends_at": {
      "type": "datetime"
    },
    "venue": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "online_link": {
      "type": "string",
      "private": true
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "description": {
      "type": "blocks"
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "fee": {
      "type": "string",
      "default": "Free"
    },
    "capacity": {
      "type": "integer"
    },
    "registration_mode": {
      "type": "enumeration",
      "enum": [
        "form",
        "whatsapp",
        "external",
        "closed"
      ],
      "default": "form",
      "required": true
    },
    "external_url": {
      "type": "string"
    },
    "publish_at": {
      "type": "datetime"
    },
    "registrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::seminar-registration.seminar-registration",
      "mappedBy": "seminar",
      "private": true
    }
  }
}