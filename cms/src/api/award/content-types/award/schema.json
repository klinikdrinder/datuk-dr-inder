{
  "kind": "collectionType",
  "collectionName": "awards",
  "info": {
    "singularName": "award",
    "pluralName": "awards",
    "displayName": "Award",
    "description": "Awards on the 3D awards ring. Add a certificate image to also show it in the award-certificates gallery."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "year": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "presented_by": {
      "type": "string",
      "required": true
    },
    "certificate_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "show_on_ring": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}