{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Journal Article",
    "description": "Journal (blog). Writers save drafts; an Editor publishes. Set \"Publish at\" to schedule."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 300
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "blocks"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "author_name": {
      "type": "string",
      "default": "Datuk Dr Inder"
    },
    "reviewed_by": {
      "type": "string",
      "default": "Datuk Dr Inderjit Kaur (DPSM), MBBS, ABHRS Diplomate"
    },
    "publish_at": {
      "type": "datetime"
    },
    "reading_minutes": {
      "type": "integer"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text",
      "maxLength": 170
    }
  }
}