{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry",
    "description": "Consultation requests from the website."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "country": {
      "type": "string"
    },
    "interest": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "booked",
        "closed"
      ],
      "default": "new"
    },
    "source": {
      "type": "string",
      "default": "website"
    },
    "consent": {
      "type": "boolean",
      "default": false
    }
  }
}