# ---- Copy to .env on the server and fill in. Never commit .env ----
HOST=0.0.0.0
PORT=1337
NODE_ENV=production
PUBLIC_URL=https://cms.datukdrinder.com
IS_PROXIED=true

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (cPanel MySQL)
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=datukdrkdi_cms
DATABASE_USERNAME=datukdrkdi_cms
DATABASE_PASSWORD=
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# Shared with the website on Vercel (same value in both places)
FORM_SECRET=
# For CSV downloads: https://cms.datukdrinder.com/api/exports/registrations?key=EXPORT_KEY
EXPORT_KEY=
CORS_ORIGINS=https://datukdrinder.com,https://www.datukdrinder.com

# Optional email alerts (cPanel mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=noreply@datukdrinder.com
SMTP_PASSWORD=
SMTP_FROM=noreply@datukdrinder.com
NOTIFY_EMAIL=

# Instagram API version (optional)
IG_API_VERSION=
